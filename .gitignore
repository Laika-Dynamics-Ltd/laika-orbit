# deps & build
node_modules/
dist/
.vite/
*.tsbuildinfo

# extraction cache — regenerable from source documents
.orbit/

# gauntlet: keep the bar, the definition and the results; drop the working copies,
# the per-round captures and the voided run (hundreds of MB of PNGs)
.gauntlet/work/
.gauntlet/void-run-1/
.gauntlet/champion/

# research: keep notes, transcripts and the cloned kit; drop the extracted frames
research/frames/

# local runtime
*.log
.DS_Store

# generated synthetic fixture — rebuild with `node packages/graph/scripts/gen-data.mjs`
packages/graph/public/brain.json

# feed credentials (calendar iCal address, mail app password)
.env.local
*.json.tmp


# personal settings (profile) — never committed
*.local.json

# showreel build output (clips, voice cache, generated HyperFrames project)
.showreel/
# synced widget data (email subjects and senders, event titles) — rebuilt by the feeds from
# brain/widgets/_<id>.template.json
brain/widgets/email.json
brain/widgets/calendar.json
# the summary card (chat titles, what they did), written by the agent host's summary routine
brain/widgets/summary.json
# widget layout: the app rewrites it on every drag; a fresh checkout starts from _settings.template.json
brain/widgets/_settings.json
# the extraction cache's name before the rename; a checkout of an older branch may still write it

# any env file except the example
.env
.env.*
!.env.example

# gauntlet scratch output and stray renders
.gauntlet/work2/
.gauntlet/champion2/
packages/graph/undefined/

# built copy of the root LICENSE for the published laikaorbit package
packages/laikaorbit/LICENSE

# written by the app for each user; the defaults apply until then
brain/index.config.json
brain/widgets/_settings.json
brain/profile.local.json
